# Copy this file to .env and fill in your values.
# cp .env.sample .env

# Required for config.yaml (official K-EXAONE 2.5 API).
EXAONE_API_KEY=

# Alternatively, reuse the macOS Keychain item registered in Pi (no key copy).
# Used only when EXAONE_API_KEY is empty. Commands run without a shell.
# EXAONE_API_KEY_COMMAND="security find-generic-password -s pi-exaone-api-key -w"

# Required for config.compare.yaml. Only explicitly named :free models are used.
OPENROUTER_API_KEY=

# Optional OpenRouter request attribution headers
OPENROUTER_HTTP_REFERER=https://your-app.example.com
OPENROUTER_APP_TITLE=llm-mafia
